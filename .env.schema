# Every env var this child reads. The Bitwarden block is generated; the rest is hand-kept knobs.
# In the fetch workspace ReTreever serves this child and its .env supplies the
# value. A standalone clone generates its own with
# _rapper/scripts/envFromBitwarden.mjs, given a Bitwarden machine token.
# WARNING: varlock reads decorators inside comments — no at-sign before a word in prose.
# @defaultSensitive=false @defaultRequired=false
# @auditIgnorePaths("_rapper", "_siblings", ".svelte-kit", "node_modules")
# @import("~/.config/varlock/.env.retreever-local", allowMissing=true)
# @plugin(../node_modules/@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ---

# @sensitive @internal @required
BWS_ACCESS_TOKEN=

# --- Bitwarden block: written from `bws secret list` by rapper/scripts/envFromBitwarden.mjs. Hand edits here are overwritten. ---
# 27 Sep 2026 — Mapbox public token for maps (browser-safe)
# @auditIgnore
PUBLIC_GC_RT_mapbox_token=bitwarden("a0c35de0-afbc-40ea-9244-b4ab00fdf6df")
# --- end Bitwarden block ---

# Vite's own build-mode flag (import.meta.env.DEV); the environment never
# sets it. Declared so audit can match the reads.
# @type=string
DEV=
